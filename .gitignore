# macOS
.DS_Store
.AppleDouble
.LSOverride

# Directory metadata
.directory

# Temporary files
*~
*.swp
*.swo
*.bak
*.tmp

# Log files
*.log

# Build artifacts and directories
**/build/
build/
build.*/
*.o
*.a
*.out
# host-side utilities compiled on Windows
*.exe

# ESP-IDF specific build outputs
*.bin
*.elf
*.map
flasher_args.json
sdkconfig.old
# sdkconfig генерируется из sdkconfig.defaults (там всё нужное)
sdkconfig

# ESP-IDF dependencies
/components/.idf/
**/components/.idf/
managed_components/
.espressif/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Python environment files
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/

# Virtual environment folders
venv/
.venv/
env/

# Language Servers
.clangd/
.ccls-cache/
compile_commands.json

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini

# User-specific configuration files
*.user
*.workspace
*.suo
*.sln.docstates

# Настройки VS Code конкретного компьютера (путь к ESP-IDF, COM-порт)
.vscode/settings.json

# Секреты (Wi-Fi, токен бота) — только локально
main/secrets.h

# Raw Claude Code chat history (contains personal data, copy manually)
.claude-history/

# Готовые прошивки для копирования (не исходники)
release/
